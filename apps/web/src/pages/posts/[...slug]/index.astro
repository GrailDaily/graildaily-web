---
import { type CollectionEntry, getCollection, render } from "astro:content";

import Header from "@/components/header/Header.astro";
import PostLayout from "@/layouts/PostLayout.astro";

import Datetime from "@/components/Datetime.astro";

import ShareLinks from "./_components/ShareLinks.astro";
import AdjacentPostNav from "./_components/AdjacentPostNav.astro";
import RelatedPosts from "@/components/post/RelatedPosts.astro";

import config from "@/config";

import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostSlug, getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const sorted = getSortedPosts(posts);

  return sorted.map((post, index) => ({
    params: {
      slug: getPostSlug(post.id, post.filePath),
    },
    props: {
      post,

      prevPost:
        index > 0
          ? {
              id: sorted[index - 1].id,
              title: sorted[index - 1].data.title,
              filePath: sorted[index - 1].filePath,
            }
          : null,

      nextPost:
        index < sorted.length - 1
          ? {
              id: sorted[index + 1].id,
              title: sorted[index + 1].data.title,
              filePath: sorted[index + 1].filePath,
            }
          : null,
    },
  }));
}

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

interface Props {
  post: CollectionEntry<"posts">;
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
}

const { post, prevPost, nextPost } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;

const {
  title,
  description,
  pubDatetime,
  modDatetime,
  timezone,
  canonicalURL,
  ogImage: initOgImage,
  tags,
} = post.data;

const { Content } = await render(post);

let ogImageUrl = initOgImage;

if (!ogImageUrl && config.features.dynamicOgImage) {
  ogImageUrl =
    getPostUrl(post.id, post.filePath, locale).replace(/\/$/, "") +
    "/index.png";
}

const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  canonicalURL={canonicalURL}
  ogImage={ogImage}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <Header />

  <!-- Reading Progress -->
  <div class="reading-progress">
    <div id="reading-progress-bar"></div>
  </div>

  <main class="article-page">
    <!-- ================= HEADER ================= -->

    <section class="article-header">
      <nav class="article-breadcrumb">
        <a href="/">Home</a>

        <span>/</span>

        <a href={`/categories/${slugifyStr(tags[0])}`}>
          {tags[0]}
        </a>
      </nav>

      <div class="article-category">
        {tags[0]}
      </div>

      <h1
        class="article-title"
        style={{
          viewTransitionName: toTransitionName(title),
        }}
      >
        {title}
      </h1>

      <p class="article-description">
        {description}
      </p>

      <div class="article-meta">
        <div class="article-author">
          <div class="author-avatar">GD</div>

          <div class="author-info">
            <strong> GrailDaily Editorial </strong>

            <Datetime
              pubDatetime={pubDatetime}
              modDatetime={modDatetime}
              timezone={timezone}
            />
          </div>
        </div>

        <ShareLinks />
      </div>
    </section>

    <!-- ================= HERO ================= -->

    {
      post.data.ogImage && (
        <section class="article-hero">
          <img src={post.data.ogImage} alt={post.data.title} />
        </section>
      )
    }

    <!-- ================= CONTENT ================= -->

    <section class="article-container">
      <article id="article" class="article-content" data-pagefind-body>
        <Content />
      </article>
    </section>

    <!-- ================= FOOTER ================= -->

    <section class="article-bottom">
      <div class="article-footer-inner">
        <AdjacentPostNav prevPost={prevPost} nextPost={nextPost} />

        <RelatedPosts currentPost={post} />
      </div>
    </section>
  </main>

  <!-- ================= READING PROGRESS ================= -->

  <script is:inline>
    function initReadingProgress() {
      const article = document.querySelector(".article-content");
      const bar = document.getElementById("reading-progress-bar");

      if (!article || !bar) return;

      function updateProgress() {
        const rect = article.getBoundingClientRect();

        const articleTop = window.scrollY + rect.top;
        const articleHeight = article.offsetHeight;

        const scroll = window.scrollY - articleTop + window.innerHeight * 0.25;

        const percent = Math.min(
          Math.max((scroll / articleHeight) * 100, 0),
          100
        );

        bar.style.width = percent + "%";
      }

      updateProgress();

      window.addEventListener("scroll", updateProgress, {
        passive: true,
      });

      window.addEventListener("resize", updateProgress);
    }

    document.addEventListener("astro:page-load", initReadingProgress);

    document.addEventListener("DOMContentLoaded", initReadingProgress);

    initReadingProgress();
  </script>
</PostLayout>
