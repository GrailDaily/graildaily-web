---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/header/Header.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";
import {
  getCmsArticles,
  getCmsTrendingArticles,
  getCmsHeroArticles,
  getCmsEditorsPicks,
} from "@/lib/cms";
import { cmsArticlesToHomePosts } from "@/lib/cms-adapter";
import HeroCarousel from "@/components/hero/HeroCarousel.astro";
import Trending from "@/components/home/Trending.astro";
import Categories from "@/components/home/Categories.astro";
import EditorPicks from "@/components/home/EditorPicks.astro";
import RecentPosts from "@/components/home/RecentPosts.astro";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const cmsArticles = await getCmsArticles();

const publishedArticles = cmsArticles.filter(
  article => article.status === "Published"
);

const posts = cmsArticlesToHomePosts(publishedArticles);

const cmsHeroArticles = await getCmsHeroArticles();
const heroPosts = cmsArticlesToHomePosts(cmsHeroArticles);

const cmsEditorsPicks = await getCmsEditorsPicks();
const editorPicksPosts = cmsArticlesToHomePosts(cmsEditorsPicks);

const cmsTrendingArticles = await getCmsTrendingArticles();
const trendingPosts = cmsArticlesToHomePosts(cmsTrendingArticles);

const sortedPosts = [...posts].sort(
  (a, b) =>
    new Date(b.data.modDatetime ?? b.data.pubDatetime).getTime() -
    new Date(a.data.modDatetime ?? a.data.pubDatetime).getTime()
);

const recentPosts = sortedPosts.slice(0, 10);

const categories = [
  {
    name: "Archaeology",
    description: "Ancient discoveries",
    href: "/categories/archaeology",
    image: "/images/categories/Archaeology.webp",
  },
  {
    name: "Economics",
    description: "Markets & trade",
    href: "/categories/economics",
    image: "/images/categories/Economics.webp",
  },
  {
    name: "Entertainment",
    description: "Movies, music & more",
    href: "/categories/entertainment",
    image: "/images/categories/Entertainment.webp",
  },
  {
    name: "Geography",
    description: "Places & regions",
    href: "/categories/geography",
    image: "/images/categories/Geography.webp",
  },
  {
    name: "History",
    description: "Explore the past",
    href: "/categories/history",
    image: "/images/categories/History.webp",
  },
  {
    name: "Humanity",
    description: "People & culture",
    href: "/categories/humanity",
    image: "/images/categories/Humanity.webp",
  },
  {
    name: "Mysteries",
    description: "Unsolved secrets",
    href: "/categories/mysteries",
    image: "/images/categories/Mysteries.webp",
  },
  {
    name: "Mythology",
    description: "Legends & myths",
    href: "/categories/mythology",
    image: "/images/categories/Mythology.webp",
  },
  {
    name: "Nature",
    description: "Our living world",
    href: "/categories/nature",
    image: "/images/categories/Nature.webp",
  },
  {
    name: "Politics",
    description: "Power & diplomacy",
    href: "/categories/politics",
    image: "/images/categories/Politics.webp",
  },
  {
    name: "Religion",
    description: "Beliefs & traditions",
    href: "/categories/religion",
    image: "/images/categories/Religion.webp",
  },
  {
    name: "Science",
    description: "Explore knowledge",
    href: "/categories/science",
    image: "/images/categories/Science.webp",
  },
  {
    name: "Space",
    description: "Beyond the stars",
    href: "/categories/space",
    image: "/images/categories/Space.webp",
  },
  {
    name: "Technology",
    description: "Ennovation",
    href: "/categories/technology",
    image: "/images/categories/Technology.webp",
  },
];
---

<Layout>
  <Header />

  <HeroCarousel posts={heroPosts} />

  <EditorPicks posts={editorPicksPosts} />

  <Trending posts={trendingPosts} />

  <RecentPosts posts={recentPosts} title={t.home.recentPosts} limit={10} />

  <Categories categories={categories} posts={posts} />

  {
    /*
<Newsletter />
*/
  }
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
