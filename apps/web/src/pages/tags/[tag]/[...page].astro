---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/header/Header.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import ArticleCard from "@/components/cards/ArticleCard.astro";
import Pagination from "@/components/Pagination.astro";
import { getCmsArticlesByTag, getCmsTags } from "@/lib/tags";
import { cmsArticlesToHomePosts } from "@/lib/cms-adapter";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const prerender = true;

export async function getStaticPaths() {
  const tags = await getCmsTags();

  const paths = [];

  for (const { tag, tagName } of tags) {
    const articles = await getCmsArticlesByTag(tag);
    const posts = cmsArticlesToHomePosts(articles);

    const pageSize = config.posts.perPage;
    const totalPages = Math.max(1, Math.ceil(posts.length / pageSize));

    for (let page = 1; page <= totalPages; page++) {
      const start = (page - 1) * pageSize;
      const pagePosts = posts.slice(start, start + pageSize);

      paths.push({
        params: {
          tag,
          page: page === 1 ? undefined : String(page),
        },
        props: {
          tagName,
          posts: pagePosts,
          currentPage: page,
          totalPages,
        },
      });
    }
  }

  return paths;
}

const {
  tagName,
  posts,
  currentPage,
  totalPages,
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const page = {
  data: posts,
  currentPage,
  lastPage: totalPages,
  url: {
    current: Astro.url.pathname,
    prev:
      currentPage > 1
        ? currentPage === 2
          ? `../`
          : `../${currentPage - 1}/`
        : undefined,
    next:
      currentPage < totalPages
        ? `../${currentPage + 1}/`
        : undefined,
  },
};
---

<Layout title={`${t.pages.tagTitle}: ${tagName} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={`${t.pages.tagTitle}: ${tagName}`}
    pageDesc={`${t.pages.tagDesc} "${tagName}".`}
  >
    <div class="article-list">
      {
        posts.map(post => (
          <ArticleCard
            post={post}
            variant="horizontal"
          />
        ))
      }
    </div>
  </Main>

  {
    totalPages > 1 && (
      <Pagination {page} />
    )
  }

  <Footer noMarginTop={totalPages > 1} />
</Layout>
