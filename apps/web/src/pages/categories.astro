---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/header/Header.astro";
import CategoryNavigation from "@/components/categories/CategoryNavigation.astro";
import CategorySection from "@/components/categories/CategorySection.astro";
import config from "@/config";
import { categories } from "@/data/categories";
import { getCmsArticles } from "@/lib/cms";
const articles = await getCmsArticles();
---

<Layout
  title={`Categories | ${config.site.title}`}
  description="Explore every category on GrailDaily."
>
  <Header />
  <CategoryNavigation categories={categories} />
  {
    categories.map((category, index) => {
      const categoryArticles = articles.filter(
        article =>
          article.category.toLowerCase() === category.name.toLowerCase()
      );
      return (
        <CategorySection
          category={category}
          index={index}
          posts={categoryArticles}
        />
      );
    })
  }
</Layout>
