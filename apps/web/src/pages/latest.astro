---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/header/Header.astro";

import config from "@/config";

import LatestHero from "@/components/latest/LatestHero.astro";
import LatestFeed from "@/components/latest/LatestFeed.astro";

import { getLatestArticles } from "@/lib/latest";

const articles = await getLatestArticles();

const latestArticle = articles[0];
const remainingArticles = articles.slice(1, 31);
---

<Layout
  title={`Latest | ${config.site.title}`}
  description="Discover the latest stories on GrailDaily."
>
  <Header />

  <main class="app-layout latest-page">
    <LatestHero article={latestArticle} />

    <LatestFeed articles={remainingArticles} />
  </main>
</Layout>
