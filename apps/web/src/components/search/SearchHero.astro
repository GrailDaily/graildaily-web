---
const popularSearches = [
  "History",
  "Archaeology",
  "Vikings",
  "Ancient Egypt",
  "Rome",
  "Science",
  "Space",
  "Mythology",
];
---

<section class="search-page">
  <header class="search-header">
    <span class="search-badge"> Search </span>

    <h1>Search the GrailDaily Archive</h1>

    <p>
      Explore thousands of articles covering history, archaeology, science,
      mythology, mysteries, and ancient civilizations.
    </p>
  </header>

  <form class="search-form" method="get" action="/search">
    <input
      type="search"
      name="q"
      value={Astro.url.searchParams.get("q") ?? ""}
      placeholder="Search articles, topics, or keywords..."
      aria-label="Search articles, topics, or keywords"
      autocomplete="off"
    />

    <button type="submit" aria-label="Search">
      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
    </button>
  </form>

  <section class="popular-searches">
    <h2>Popular Searches</h2>

    <div class="popular-search-list">
      {
        popularSearches.map(tag => (
          <a
            class="popular-search"
            href={`/search?q=${encodeURIComponent(tag)}`}
          >
            {tag}
          </a>
        ))
      }
    </div>
  </section>
</section>
