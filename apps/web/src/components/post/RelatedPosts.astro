---
import ArticleCard from "@/components/cards/ArticleCard.astro";
import { getCmsArticles } from "@/lib/cms";
import { cmsArticlesToHomePosts } from "@/lib/cms-adapter";
import type { HomePost } from "@/lib/home-post";

const { currentPost } = Astro.props as {
  currentPost: HomePost;
};

const cmsArticles = await getCmsArticles();

const posts = cmsArticlesToHomePosts(
  cmsArticles.filter(article => article.status === "Published")
);

const relatedPosts = posts
  .filter(post => post.id !== currentPost.id)
  .filter(post => {
    const currentCategory = currentPost.data.tags?.[0];
    const postCategory = post.data.tags?.[0];

    return (
      currentCategory &&
      postCategory &&
      currentCategory.toLowerCase() === postCategory.toLowerCase()
    );
  })
  .slice(0, 3);
---

{
  relatedPosts.length > 0 && (
    <section class="related-posts">
      <h2>Related Stories</h2>

      <div class="related-grid">
        {relatedPosts.map(post => (
          <ArticleCard post={post} variant="related" />
        ))}
      </div>
    </section>
  )
}

<style>
  .related-posts {
    margin-top: 7rem;

    padding-top: 4rem;

    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .related-posts h2 {
    font-family: "Playfair Display";

    font-size: 2.4rem;

    font-weight: 700;

    margin-bottom: 2.5rem;
  }

  .related-grid {
    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: 1.75rem;
  }

  @media (max-width: 900px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
