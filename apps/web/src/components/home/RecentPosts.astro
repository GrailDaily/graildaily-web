---
import type { HomePost } from "@/lib/home-post";
import ArticleCard from "@/components/cards/ArticleCard.astro";

interface Props {
  posts: HomePost[];
  title: string;
  limit: number;
}

const { posts, title, limit } = Astro.props;
---

<section id="recent-posts" class="recent-posts">
  <div class="app-layout">
    <div class="section-header">
      <h2 class="title">
        {title}
      </h2>
    </div>

    <div class="grid">
      {
        posts
          .slice(0, limit)
          .map(post => <ArticleCard post={post} variant="horizontal-small" />)
      }
    </div>
  </div>
</section>

<style>
  .recent-posts {
    padding: 20px 0;
  }

  .title {
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--foreground);
    margin-bottom: 24px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 24px;
  }

  .section-header {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .grid :global(.article-card.horizontal-small) {
      grid-template-columns: 30% 1fr;
      gap: 12px;
      padding: 10px;
      min-height: 0;
    }

    .grid :global(.article-card.horizontal-small .thumbnail) {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 10;
      margin: 0;
    }

    .grid :global(.article-card.horizontal-small .excerpt) {
      display: none !important;
      visibility: hidden;
      height: 0 !important;
      min-height: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
      overflow: hidden;
    }

    .grid :global(.article-card.horizontal-small .content) {
      min-width: 0;
    }

    .grid :global(.article-card.horizontal-small h3) {
      font-size: 0.95rem;
      line-height: 1.3;
      height: auto;
      max-height: 2.6em;
    }

    .grid :global(.article-card.horizontal-small .meta) {
      margin-top: 8px;
      padding-top: 0;
      font-size: 0.7rem;
      gap: 0.35rem;
    }
  }
</style>
