---
import type { CmsArticle } from "@/lib/cms";
interface Props {
  posts: CmsArticle[];
}
const { posts } = Astro.props;
---

<aside class="top-articles">
  <h3>Top Articles</h3>
  {
    posts.map(post => (
      <a href={`/cms-posts/${post.slug}/`} class="top-item">
        {" "}
        {post.featuredImage && (
          <img src={post.featuredImage} alt={post.title} loading="lazy" />
        )}{" "}
        <h4>{post.title}</h4>{" "}
      </a>
    ))
  }
</aside>
<style>
  .top-articles {
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 8px 20px 8px 20px;
    display: flex;
    flex-direction: column;
  }
  .top-articles h3 {
    margin-bottom: 8px;
    font-size: 1.1rem;
  }
  .top-item {
    display: grid;
    grid-template-columns: 78px 1fr;
    gap: 12px;
    align-items: center;
    text-decoration: none;
    color: inherit;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    transition: 0.25s ease;
  }
  .top-item img {
    width: 78px;
    aspect-ratio: 16/10;
    object-fit: cover;
    border-radius: 10px;
    transition: transform 0.25s ease;
  }
  .top-item h4 {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.25s ease;
  }
  .top-item:hover h4 {
    color: var(--accent);
  }
  .top-item:hover img {
    transform: scale(1.03);
  }
  .top-item:last-child {
    border-bottom: none;
  }
  .top-item:first-of-type {
    border-top: none;
    padding-top: 0;
  }
</style>
