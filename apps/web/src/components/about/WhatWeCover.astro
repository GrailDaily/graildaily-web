---
const categories = [
  {
    title: "Archaeology",
    description:
      "Ancient ruins, artifacts, excavations, and forgotten civilizations.",
    image: "/images/categories/Archaeology.webp",
  },
  {
    title: "Economics",
    description:
      "Global markets, trade, finance, and the forces shaping economies.",
    image: "/images/categories/Economics.webp",
  },
  {
    title: "Entertainment",
    description: "Cinema, television, music, literature, and popular culture.",
    image: "/images/categories/Entertainment.webp",
  },
  {
    title: "Geography",
    description:
      "Countries, landscapes, cultures, and remarkable places around the world.",
    image: "/images/categories/Geography.webp",
  },
  {
    title: "History",
    description: "Empires, historical figures, battles, and remarkable events.",
    image: "/images/categories/History.webp",
  },
  {
    title: "Humanity",
    description:
      "People, societies, traditions, and the evolution of civilization.",
    image: "/images/categories/Humanity.webp",
  },
  {
    title: "Mysteries",
    description:
      "Unsolved events, unexplained phenomena, and enduring questions.",
    image: "/images/categories/Mysteries.webp",
  },
  {
    title: "Mythology",
    description: "Legends, myths, gods, heroes, and ancient folklore.",
    image: "/images/categories/Mythology.webp",
  },
  {
    title: "Nature",
    description: "Wildlife, ecosystems, natural wonders, and Earth's beauty.",
    image: "/images/categories/Nature.webp",
  },
  {
    title: "Politics",
    description: "Governments, diplomacy, conflicts, and global affairs.",
    image: "/images/categories/Politics.webp",
  },
  {
    title: "Religion",
    description: "Beliefs, traditions, sacred places, and religious history.",
    image: "/images/categories/Religion.webp",
  },
  {
    title: "Science",
    description:
      "Breakthroughs, discoveries, and the fascinating world of research.",
    image: "/images/categories/Science.webp",
  },
  {
    title: "Space",
    description:
      "Galaxies, planets, black holes, and the mysteries beyond Earth.",
    image: "/images/categories/Space.webp",
  },
  {
    title: "Technology",
    description: "Innovation, AI, engineering, and the future of technology.",
    image: "/images/categories/Technology.webp",
  },
];
---

<section class="what-we-cover">
  <div class="app-layout">
    <div class="section-header">
      <span class="section-label">WHAT WE COVER</span>

      <h2>Explore the topics we are passionate about</h2>

      <p>
        From people and places to ideas, events, discoveries, and the forces
        shaping our world, GrailDaily explores a wide range of topics that
        inspire curiosity and broaden our perspective.
      </p>
    </div>

    <div class="cover-grid">
      {
        categories.map(category => (
          <article class="cover-card">
            <img
              class="cover-image"
              src={category.image}
              srcset={`
            ${category.image.replace(/\.webp$/i, "")}-320.webp 320w,
            ${category.image.replace(/\.webp$/i, "")}-480.webp 480w,
            ${category.image.replace(/\.webp$/i, "")}-640.webp 640w,
            ${category.image.replace(/\.webp$/i, "")}-960.webp 960w,
            ${category.image.replace(/\.webp$/i, "")}-1280.webp 1280w
          `}
              sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 25vw"
              alt={category.title}
              loading="lazy"
              decoding="async"
            />

            <div class="cover-overlay" />

            <h3>{category.title}</h3>

            <p>{category.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
<style>
  .what-we-cover {
    padding: 90px 0;
  }

  .section-header {
    max-width: 760px;

    margin: 0 auto 56px;

    text-align: center;
  }

  .section-header h2 {
    margin: 18px 0;

    font-size: 2.7rem;
  }

  .section-header p {
    color: var(--muted-foreground);

    line-height: 1.8;
  }

  .cover-grid {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 28px;
  }

  .cover-card {
    position: relative;
    isolation: isolate;

    min-height: 320px;
    padding: 28px;

    display: flex;
    flex-direction: column;
    justify-content: flex-end;

    overflow: hidden;
    border-radius: 22px;
    border: 1px solid var(--border);

    color: white;

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .cover-image {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    z-index: -2;
  }

  .cover-overlay {
    position: absolute;
    inset: 0;

    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.82),
      rgba(0, 0, 0, 0.45),
      rgba(0, 0, 0, 0.15)
    );

    z-index: -1;
  }

  .cover-card:hover {
    transform: translateY(-6px);

    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.18);
  }

  .cover-card h3 {
    margin-bottom: 12px;

    font-size: 1.5rem;

    color: white;
  }

  .cover-card p {
    color: rgba(255, 255, 255, 0.9);

    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .what-we-cover {
      padding: 56px 0;
    }

    .section-header {
      margin-bottom: 36px;
    }

    .section-header h2 {
      font-size: 2rem;
    }

    .section-header p {
      font-size: 0.95rem;
    }

    .cover-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .cover-card {
      min-height: 220px;
      padding: 20px;
    }

    .cover-card h3 {
      font-size: 1.3rem;
    }

    .cover-card p {
      font-size: 0.92rem;
    }
  }
</style>
