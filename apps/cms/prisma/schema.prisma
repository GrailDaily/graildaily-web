generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Article {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String
  content       String
  featuredImage String?
  category      String
  author        String
  status        ArticleStatus
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  publishedAt   DateTime?
}

model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())
  publicId     String?
}

enum ArticleStatus {
  Draft
  Review
  Scheduled
  Published
  Archived
}
