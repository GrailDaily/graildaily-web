generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String
  content       String
  featuredImage String?
  category      String
  author        String
  authorUserId  String?
  status        ArticleStatus
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  publishedAt   DateTime?

  views      ArticleView[]
  authorUser User?         @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
}

model ArticleView {
  id        String   @id @default(cuid())
  articleId String
  viewedAt  DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([viewedAt])
  @@index([articleId, viewedAt])
}

model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())
  publicId     String?
}

model Category {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  description String
  image       String?
  status      CategoryStatus @default(Active)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
}

enum CategoryStatus {
  Active
  Inactive
}

model SiteSettings {
  id          String   @id @default(cuid())
  siteName    String   @default("GrailDaily")
  description String   @default("Discover stories about history, science, mysteries, culture, and the world around us.")
  siteUrl     String   @default("https://graildaily.com")
  language    String   @default("English")
  timezone    String   @default("Asia/Jakarta")
  updatedAt   DateTime @updatedAt
}

enum ArticleStatus {
  Draft
  Review
  Scheduled
  Published
  Archived
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  role      UserRole   @default(Author)
  status    UserStatus @default(Active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  articles Article[]

  @@index([role])
  @@index([status])
}

enum UserRole {
  Admin
  Editor
  Author
}

enum UserStatus {
  Active
  Inactive
}